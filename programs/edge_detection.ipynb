      "source": [
        "import time\n",
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# -------------------------------------------------------------------------\n",
        "# 1. SETUP & UTILITY FUNCTIONS\n",
        "# -------------------------------------------------------------------------"
      ],
      "metadata": {
        "id": "EKH1K9esEjiD"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def create_sample_image():\n",
        "    \"\"\"Generates a synthetic test image with shapes and noise if no image is uploaded.\"\"\"\n",
        "    img = np.zeros((300, 300), dtype=np.uint8)\n",
        "    # Add shapes\n",
        "    cv2.rectangle(img, (50, 50), (150, 150), 255, -1)\n",
        "    # Axis-Aligned Edges (0* & 90*): Sobel and Prewitt X/Y kernels excel at detecting flat horizontal and vertical lines.
        "    # Corner Detection: Canny preserves sharp 90* turn points, whereas Gaussian and Laplacian operators round them off.
        "    cv2.circle(img, (220, 220), 40, 255, -1)\n",
        "    # Diagonal & Curved Edges (0* - 360*): Continuous curves test an operator's ability to accurately calculate gradient magnitudes across changing slopes.
        "    # Kernel Weaknesses: Small 2 x 2 operators like Roberts Cross create jagged lines on smooth curves, whereas larger Sobel or Canny operators yield far smoother edges.
        "    # Operators like Sobel and Prewitt use specialized X and Y derivative kernels to detect crisp horizontal and vertical edges.
        "    # Add Gaussian noise\n",
        "    noise = np.random.normal(0, 15, img.shape).astype(np.uint8)\n",
        "    noisy_img = cv2.add(img, noise)\n",
        "    return noisy_img\n",
        "\n",
        "\n",
        "# 1. Attempt to load the file\n",
        "img = cv2.imread(\"edge-detection.jpg\", cv2.IMREAD_GRAYSCALE)\n",
        "\n",
        "# 2. Check if the file loaded successfully; fall back if it failed\n",
        "if img is None:\n",
        "    print(\n",
        "        \"Notice: 'edge-detection.jpg' not found. Falling back to synthetic image.\"\n",
        "    )\n",
        "    img = create_sample_image()\n",
        "else:\n",
        "    print(\"Successfully loaded 'edge-detection.jpg'.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "BorY-0tKEiq8",
        "outputId": "30883927-94e4-4993-866d-7b1fde6cabc4"
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Successfully loaded 'edge-detection.jpg'.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# -------------------------------------------------------------------------\n",
        "# 2. EDGE DETECTION OPERATORS IMPLEMENTATION\n",
        "# -------------------------------------------------------------------------"
      ],
      "metadata": {
        "id": "49Y3zPJPEol7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# A. Sobel Operator\n",
        "def run_sobel(image):\n",
        "    start_time = time.time()\n",
        "    sobel_x = cv2.Sobel(image, cv2.CV_64F, 1, 0, ksize=3)\n",
        "    sobel_y = cv2.Sobel(image, cv2.CV_64F, 0, 1, ksize=3)\n",
        "    magnitude = cv2.magnitude(sobel_x, sobel_y)\n",
        "    exec_time = (time.time() - start_time) * 1000  # in ms\n",
        "    return np.uint8(np.clip(magnitude, 0, 255)), exec_time\n",
        "\n",
        "\n",
        "# B. Prewitt Operator\n",
        "def run_prewitt(image):\n",
        "    start_time = time.time()\n",
        "    kernel_x = np.array([[-1, 0, 1], [-1, 0, 1], [-1, 0, 1]], dtype=np.float32)\n",
        "    kernel_y = np.array([[-1, -1, -1], [0, 0, 0], [1, 1, 1]], dtype=np.float32)\n",
        "\n",
        "    prewitt_x = cv2.filter2D(image, cv2.CV_64F, kernel_x)\n",
        "    prewitt_y = cv2.filter2D(image, cv2.CV_64F, kernel_y)\n",
        "    magnitude = cv2.magnitude(prewitt_x, prewitt_y)\n",
        "    exec_time = (time.time() - start_time) * 1000\n",
        "    return np.uint8(np.clip(magnitude, 0, 255)), exec_time\n",
        "\n",
        "\n",
        "# C. Roberts Cross Operator\n",
        "def run_roberts(image):\n",
        "    start_time = time.time()\n",
        "    kernel_x = np.array([[1, 0], [0, -1]], dtype=np.float32)\n",
        "    kernel_y = np.array([[0, 1], [-1, 0]], dtype=np.float32)\n",
        "\n",
        "    roberts_x = cv2.filter2D(image, cv2.CV_64F, kernel_x)\n",
        "    roberts_y = cv2.filter2D(image, cv2.CV_64F, kernel_y)\n",
        "    magnitude = cv2.magnitude(roberts_x, roberts_y)\n",
        "    exec_time = (time.time() - start_time) * 1000\n",
        "    return np.uint8(np.clip(magnitude, 0, 255)), exec_time\n",
        "\n",
        "\n",
        "# D. Laplacian Operator (2nd Order Derivative)\n",
        "def run_laplacian(image):\n",
        "    start_time = time.time()\n",
        "    lap = cv2.Laplacian(image, cv2.CV_64F, ksize=3)\n",
        "    magnitude = np.abs(lap)\n",
        "    exec_time = (time.time() - start_time) * 1000\n",
        "    return np.uint8(np.clip(magnitude, 0, 255)), exec_time\n",
        "\n",
        "\n",
        "# E. Canny Edge Detector (Multi-stage)\n",
        "def run_canny(image):\n",
        "    start_time = time.time()\n",
        "    # Includes Gaussian Blur, Sobel Gradient, Non-Max Suppression, Double Thresholding, Hysteresis\n",
        "    edges = cv2.Canny(image, threshold1=50, threshold2=150)\n",
        "    exec_time = (time.time() - start_time) * 1000\n",
        "    return edges, exec_time"
      ],
      "metadata": {
        "id": "K-QlLLGwElsz"
      },
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# -------------------------------------------------------------------------\n",
        "# 3. EXECUTION & VISUALIZATION\n",
        "# -------------------------------------------------------------------------"
      ],
      "metadata": {
        "id": "KlRJ-QlxEtw7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Execute all operators\n",
        "sobel_img, t_sobel = run_sobel(img)\n",
        "prewitt_img, t_prewitt = run_prewitt(img)\n",
        "roberts_img, t_roberts = run_roberts(img)\n",
        "laplacian_img, t_laplacian = run_laplacian(img)\n",
        "canny_img, t_canny = run_canny(img)\n",
        "\n",
        "# Display Results Side-by-Side\n",
        "results = {\n",
        "    \"Original (Noisy)\": img,\n",
        "    f\"Sobel ({t_sobel:.2f} ms)\": sobel_img,\n",
        "    f\"Prewitt ({t_prewitt:.2f} ms)\": prewitt_img,\n",
        "    f\"Roberts ({t_roberts:.2f} ms)\": roberts_img,\n",
        "    f\"Laplacian ({t_laplacian:.2f} ms)\": laplacian_img,\n",
        "    f\"Canny ({t_canny:.2f} ms)\": canny_img,\n",
        "}\n",
        "\n",
        "plt.figure(figsize=(15, 10))\n",
        "for i, (title, result_img) in enumerate(results.items()):\n",
        "    plt.subplot(2, 3, i + 1)\n",
        "    plt.imshow(result_img, cmap=\"gray\")\n",
        "    plt.title(title, fontsize=12)\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
